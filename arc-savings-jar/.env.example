# ---------------------------------------------------------------------------
# Arc Savings Jar - environment configuration
# Copy to `.env.local` and fill in. Every value below already has a safe
# default baked into the app, so `npm run dev` works with no .env at all.
# ---------------------------------------------------------------------------

# WalletConnect project id (https://cloud.reown.com). Only needed for the
# WalletConnect option inside RainbowKit. Injected wallets still work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed SavingsJar.sol address on Arc Mainnet.
# Also editable directly in config/contracts.ts
NEXT_PUBLIC_SAVINGS_JAR_ADDRESS=

# "mainnet" (Arc Mainnet, chainId 5042) or "testnet" (Arc Testnet, chainId 5042002)
NEXT_PUBLIC_TARGET_NETWORK=mainnet

# --- Contract deployment (Hardhat) ---
# PRIVATE_KEY=0x...
# ARC_RPC_URL=https://rpc.mainnet.arc.io
